@chcp 936 >nul
@echo off
setlocal
title 植物大战僵尸 · 全新重构架构版
cd /d "%~dp0"

echo =======================================================
echo          植物大战僵尸 · 全新架构增强版
echo =======================================================
echo [1] 真全屏支持：按 F11 或 Alt+Enter 无缝切换全屏
echo [2] 自动吸阳光：通关第 10 关解锁，按 [A] 或点击随心切换
echo [3] 玉米投掷：投掷黄油定身控场，精准命中
echo [4] 双子向日葵：正统 125 阳光升级种植
echo [5] 读报僵尸：暴怒状态血条永久清晰稳定
echo [6] 水上地图：像素级坐标对齐，睡莲与水生机制健全
